# Copy to .env (gitignored) to override defaults for `npm run dev` / `npm run build`.
# Base URL of the backend API, inlined into the bundle at build time.
# Without this variable the frontend uses /api/: the Vite dev server (vite.config.ts) and nginx (nginx.conf) proxy it
# to the API. An absolute URL (e.g. http://localhost:8000/) bypasses the proxy; the API then needs the frontend origin
# in CORS_ORIGINS.
VITE_API_URL=/api/
