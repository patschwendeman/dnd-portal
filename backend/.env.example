# Vorlage für backend/.env (gitignored): cp .env.example .env und Platzhalter ersetzen.

# PostgreSQL (Container "db" aus docker-compose.yml)
DRIVERNAME=postgresql+psycopg2
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database>
# HOST=db ist der Service-Name im Compose-Netz – die API läuft damit nur im Container.
# Für eine API außerhalb von Docker wäre HOST=localhost nötig.
HOST=db
PORT=5432

# pgAdmin (http://localhost:5050, nur mit: docker compose --profile tools up)
PGADMIN_DEFAULT_EMAIL=<email>
PGADMIN_DEFAULT_PASSWORD=<password>
