# Vorlage für backend/.env (gitignored): cp .env.example .env und Platzhalter ersetzen.

# PostgreSQL (Service `db` aus ../compose.dev.yaml bzw. ../compose.prod.yaml); POSTGRES_* nutzen Postgres-Container und API gemeinsam
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database>

# Verbindung der API zur Datenbank
DB_DRIVER=postgresql+psycopg2
# DB_HOST=db ist der Service-Name im Compose-Netz – die API läuft damit nur im Container.
# Für eine API außerhalb von Docker (z. B. uv run pytest) DB_HOST=localhost setzen.
DB_HOST=db
DB_PORT=5432

# CORS (optional, JSON-Liste). Default: ["http://localhost:5173","http://localhost:8080"] (Dev- und Prod-Frontend).
# Gilt auch für die Origin-Prüfung des WebSockets /ws. Für den LAN-Zugriff über den Proxy des Frontends
# (http://<IP>:8080, API unter /api/ und /ws) ist kein Eintrag nötig; nur direkte Zugriffe auf Port 8000 aus einem
# anderen Origin brauchen ihn, z. B.:
# CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://192.168.x.y:8080"]

# Medienordner der Szenen (Bilder, Musik), ausgeliefert unter /media (optional). Default: /app/media – dorthin binden
# ../compose.dev.yaml und ../compose.prod.yaml den Ordner ../media ein. Für eine API außerhalb von Docker den Pfad
# zum Ordner media/ im Repo-Root setzen, z. B. MEDIA_DIR=../media.
# MEDIA_DIR=/app/media

# pgAdmin (http://localhost:5050, nur mit Profil tools: `dnd dev --tools` oder im Repo-Root `docker compose -f compose.dev.yaml --profile tools up`)
PGADMIN_DEFAULT_EMAIL=<email>
PGADMIN_DEFAULT_PASSWORD=<password>
