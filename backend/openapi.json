        "title": "AudioUpdate",
        "type": "object"
      },
      "Combatant": {
        "description": "A participant of the fight: a player (`player_id`) or an NPC (`enemy`/`ally`) with the `number` of its figure on\nthe table and an optional `label` that only the Admin shows.",
        "properties": {
          "defeated": {
            "title": "Defeated",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "player",
              "enemy",
              "ally"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"
          },
          "player_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Id"
          }
        },
        "required": [
          "id",
          "kind",
          "player_id",
          "number",
          "label",
          "defeated"
        ],
        "title": "Combatant",
        "type": "object"
      },
      "CombatantCreate": {
        "description": "A player (`player_id`, nothing else) or an NPC (`number`, optional `label`; trimmed, empty = none).",
        "properties": {
          "kind": {
            "enum": [
              "player",
              "enemy",
              "ally"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "number": {
            "anyOf": [
              {
                "maximum": 99.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"
          },
          "player_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Id"
          }
        },
        "required": [
          "kind"
        ],
        "title": "CombatantCreate",
        "type": "object"
      },
      "CombatantUpdate": {
        "properties": {
          "defeated": {
            "title": "Defeated",
            "type": "boolean"
          }
        },
        "required": [
          "defeated"
        ],
        "title": "CombatantUpdate",
        "type": "object"
      },
      "FightOrder": {
        "description": "The new initiative order: exactly the IDs of the current combatants.",
        "properties": {
          "combatant_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Combatant Ids",
            "type": "array"
          }
        },
        "required": [
          "combatant_ids"
        ],
        "title": "FightOrder",
        "type": "object"
      },
      "FightStart": {
        "properties": {
          "combatants": {
            "items": {
              "$ref": "#/components/schemas/CombatantCreate"
            },
            "minItems": 1,
            "title": "Combatants",
            "type": "array"
          }
        },
        "required": [
          "combatants"
        ],
        "title": "FightStart",
        "type": "object"
      },
      "FightState": {
        "description": "The running fight of the active adventure; `combatants` in initiative order, `null` turn: nobody is left.",
        "properties": {
          "active_combatant_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Combatant Id"
          },
          "combatants": {
            "items": {
              "$ref": "#/components/schemas/Combatant"
            },
            "title": "Combatants",
            "type": "array"
          },
          "round": {
            "title": "Round",
            "type": "integer"
          },
          "scene_id": {
            "title": "Scene Id",
            "type": "integer"
          }
        },
        "required": [
          "round",
          "active_combatant_id",
          "scene_id",
          "combatants"
        ],
        "title": "FightState",
        "type": "object"
      },
      "GameTableState": {
        "description": "State of the game table shared by Admin, Wall and Ground; `active_scene_id` belongs to the active adventure.\n\n`wall_overlay` is what the Walls show above the scene image (`world`: the world map, `join`: the QR code of the\nPlayer URL); it is kept in memory only and set to `off` whenever the active scene or adventure changes.\n`ground_grid` (line colour or `off`) and `ground_grid_cell_size` (in px) are the grid of the Grounds, unchanged by\nscene or adventure changes; the colour is kept in memory only (`off` after a restart), the cell size is stored.",
        "properties": {
          "active_adventure_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Adventure Id"
          },
          "active_scene_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Scene Id"
          },
          "ground_grid": {
            "enum": [
              "black",
              "white",
              "off"
            ],
            "title": "Ground Grid",
            "type": "string"
          },
          "ground_grid_cell_size": {
            "maximum": 200.0,
            "minimum": 100.0,
            "multipleOf": 10.0,
            "title": "Ground Grid Cell Size",
            "type": "integer"
          },
          "theme": {
            "enum": [
              "cyber",
              "tavern"
            ],
            "title": "Theme",
            "type": "string"
          },
          "wall_overlay": {
            "enum": [
              "world",
              "join",
              "off"
            ],
            "title": "Wall Overlay",
            "type": "string"
          }
        },
        "required": [
          "active_adventure_id",
          "active_scene_id",
          "theme",
          "wall_overlay",
          "ground_grid",
          "ground_grid_cell_size"
        ],
        "title": "GameTableState",
        "type": "object"
      },
      "GameTableUpdate": {
        "description": "Partial update: only the fields set in the request are changed (`active_adventure_id: null` clears it).",
        "properties": {
          "active_adventure_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Adventure Id"
          },
          "ground_grid": {
            "enum": [
              "black",
              "white",
              "off"
            ],
            "title": "Ground Grid",
            "type": "string"
          },
          "ground_grid_cell_size": {
            "maximum": 200.0,
            "minimum": 100.0,
            "multipleOf": 10.0,
            "title": "Ground Grid Cell Size",
            "type": "integer"
          },
          "theme": {
            "enum": [
              "cyber",
              "tavern"
            ],
            "title": "Theme",
            "type": "string"
          },
          "wall_overlay": {
            "enum": [
              "world",
              "join",
              "off"
            ],
            "title": "Wall Overlay",
            "type": "string"
          }
        },
        "title": "GameTableUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Image": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
