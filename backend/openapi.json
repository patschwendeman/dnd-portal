{
  "components": {
    "schemas": {
      "AdventureDetail": {
        "properties": {
          "active_scene_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Scene Id"
          },
          "background_dark": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Image"
              },
              {
                "type": "null"
              }
            ]
          },
          "background_tavern": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Image"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "global_level": {
            "title": "Global Level",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/Player"
            },
            "title": "Players",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "global_level",
          "active_scene_id",
          "players",
          "background_dark",
          "background_tavern"
        ],
        "title": "AdventureDetail",
        "type": "object"
      },
      "AdventureSummary": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "title": "AdventureSummary",
        "type": "object"
      },
      "AdventureUpdate": {
        "description": "Partial update: only the fields set in the request are changed (`active_scene_id: null` clears it).",
        "properties": {
          "active_scene_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Scene Id"
          },
          "global_level": {
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Global Level",
            "type": "integer"
          }
        },
        "title": "AdventureUpdate",
        "type": "object"
      },
      "AudioState": {
        "description": "Music of the game table, played by the Admin that is the audio output (`output_ready`); volume in percent.",
        "properties": {
          "output_ready": {
            "title": "Output Ready",
            "type": "boolean"
          },
          "playing": {
            "title": "Playing",
            "type": "boolean"
          },
          "track": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Track"
              },
              {
                "type": "null"
              }
            ]
          },
          "volume": {
            "title": "Volume",
            "type": "integer"
          }
        },
        "required": [
          "playing",
          "track",
          "volume",
          "output_ready"
        ],
        "title": "AudioState",
        "type": "object"
      },
      "AudioUpdate": {
        "description": "Partial update: only the fields set in the request are changed.",
        "properties": {
          "playing": {
            "title": "Playing",
            "type": "boolean"
          },
          "volume": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Volume",
            "type": "integer"
          }
        },
        "title": "AudioUpdate",
        "type": "object"
      },
      "Combatant": {
        "description": "A participant of the fight: a player (`player_id`) or an NPC (`enemy`/`ally`) with the `number` of its figure on\nthe table and an optional `label` that only the Admin shows.",
        "properties": {
          "defeated": {
            "title": "Defeated",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "player",
              "enemy",
              "ally"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"
          },
          "player_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Id"
          }
        },
        "required": [
          "id",
          "kind",
          "player_id",
          "number",
          "label",
          "defeated"
        ],
        "title": "Combatant",
        "type": "object"
      },
      "CombatantCreate": {
        "description": "A player (`player_id`, nothing else) or an NPC (`number`, optional `label`; trimmed, empty = none).",
        "properties": {
          "kind": {
            "enum": [
              "player",
              "enemy",
              "ally"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "number": {
            "anyOf": [
              {
                "maximum": 99.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"
          },
          "player_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Id"
          }
        },
        "required": [
          "kind"
        ],
        "title": "CombatantCreate",
        "type": "object"
      },
      "CombatantUpdate": {
        "properties": {
          "defeated": {
            "title": "Defeated",
            "type": "boolean"
          }
        },
        "required": [
          "defeated"
        ],
        "title": "CombatantUpdate",
        "type": "object"
      },
      "FightOrder": {
        "description": "The new initiative order: exactly the IDs of the current combatants.",
        "properties": {
          "combatant_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Combatant Ids",
            "type": "array"
          }
        },
        "required": [
          "combatant_ids"
        ],
        "title": "FightOrder",
        "type": "object"
      },
      "FightStart": {
        "properties": {
          "combatants": {
            "items": {
              "$ref": "#/components/schemas/CombatantCreate"
            },
            "minItems": 1,
            "title": "Combatants",
            "type": "array"
          }
        },
        "required": [
          "combatants"
        ],
        "title": "FightStart",
        "type": "object"
      },
      "FightState": {
        "description": "The running fight of the active adventure; `combatants` in initiative order, `null` turn: nobody is left.",
        "properties": {
          "active_combatant_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Combatant Id"
          },
          "combatants": {
            "items": {
              "$ref": "#/components/schemas/Combatant"
            },
            "title": "Combatants",
            "type": "array"
          },
          "round": {
            "title": "Round",
            "type": "integer"
          },
          "scene_id": {
            "title": "Scene Id",
            "type": "integer"
          }
        },
        "required": [
          "round",
          "active_combatant_id",
          "scene_id",
          "combatants"
        ],
        "title": "FightState",
        "type": "object"
      },
      "GameTableState": {
        "description": "State of the game table shared by Admin, Wall and Ground; `active_scene_id` belongs to the active adventure.\n\n`wall_overlay` is what the Walls show above the scene image (`world`: the world map, `join`: the QR code of the\nPlayer URL); it is kept in memory only and set to `off` whenever the active scene or adventure changes.\n`ground_grid` (line colour or `off`) and `ground_grid_cell_size` (in px) are the grid of the Grounds, unchanged by\nscene or adventure changes; the colour is kept in memory only (`off` after a restart), the cell size is stored.",
        "properties": {
          "active_adventure_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Adventure Id"
          },
          "active_scene_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Scene Id"
          },
          "ground_grid": {
            "enum": [
              "black",
              "white",
              "off"
            ],
            "title": "Ground Grid",
            "type": "string"
          },
          "ground_grid_cell_size": {
            "maximum": 200.0,
            "minimum": 100.0,
            "multipleOf": 10.0,
            "title": "Ground Grid Cell Size",
            "type": "integer"
          },
          "theme": {
            "enum": [
              "dark",
              "tavern"
            ],
            "title": "Theme",
            "type": "string"
          },
          "wall_overlay": {
            "enum": [
              "world",
              "join",
              "off"
            ],
            "title": "Wall Overlay",
            "type": "string"
          }
        },
        "required": [
          "active_adventure_id",
          "active_scene_id",
          "theme",
          "wall_overlay",
          "ground_grid",
          "ground_grid_cell_size"
        ],
        "title": "GameTableState",
        "type": "object"
      },
      "GameTableUpdate": {
        "description": "Partial update: only the fields set in the request are changed (`active_adventure_id: null` clears it).",
        "properties": {
          "active_adventure_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Adventure Id"
          },
          "ground_grid": {
            "enum": [
              "black",
              "white",
              "off"
            ],
            "title": "Ground Grid",
            "type": "string"
          },
          "ground_grid_cell_size": {
            "maximum": 200.0,
            "minimum": 100.0,
            "multipleOf": 10.0,
            "title": "Ground Grid Cell Size",
            "type": "integer"
          },
          "theme": {
            "enum": [
              "dark",
              "tavern"
            ],
            "title": "Theme",
            "type": "string"
          },
          "wall_overlay": {
            "enum": [
              "world",
              "join",
              "off"
            ],
            "title": "Wall Overlay",
            "type": "string"
          }
        },
        "title": "GameTableUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Image": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "source"
        ],
        "title": "Image",
        "type": "object"
      },
      "JoinInfo": {
        "description": "How players join the game table: URL of the Player Screen in the LAN, `null` if unknown.",
        "properties": {
          "player_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Url"
          }
        },
        "required": [
          "player_url"
        ],
        "title": "JoinInfo",
        "type": "object"
      },
      "Player": {
        "description": "A person with their character in one adventure (another adventure has its own entry for the same person).",
        "properties": {
          "avatar": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Image"
              },
              {
                "type": "null"
              }
            ]
          },
          "character_class": {
            "title": "Character Class",
            "type": "string"
          },
          "character_name": {
            "title": "Character Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "player_name": {
            "title": "Player Name",
            "type": "string"
          },
          "race": {
            "title": "Race",
            "type": "string"
          }
        },
        "required": [
          "id",
          "player_name",
          "character_name",
          "race",
          "character_class",
          "avatar"
        ],
        "title": "Player",
        "type": "object"
      },
      "SceneDetail": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "ground_image": {
            "$ref": "#/components/schemas/Image"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/Track"
            },
            "title": "Tracks",
            "type": "array"
          },
          "wall_image": {
            "$ref": "#/components/schemas/Image"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "wall_image",
          "ground_image",
          "tracks"
        ],
        "title": "SceneDetail",
        "type": "object"
      },
      "SoundRequest": {
        "properties": {
          "name": {
            "enum": [
              "heal",
              "bottle",
              "buff",
              "music_1",
              "music_2",
              "spell_1",
              "spell_2",
              "debuff_1",
              "debuff_2",
              "lock"
            ],
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "SoundRequest",
        "type": "object"
      },
      "Track": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "source"
        ],
        "title": "Track",
        "type": "object"
      },
      "TurnRequest": {
        "description": "Ends the turn of `from_combatant_id`; if it is no longer the turn of that combatant, nothing changes.",
        "properties": {
          "from_combatant_id": {
            "title": "From Combatant Id",
            "type": "integer"
          }
        },
        "required": [
          "from_combatant_id"
        ],
        "title": "TurnRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/adventures": {
      "get": {
        "operationId": "read_adventures_adventures_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdventureSummary"
                  },
                  "title": "Response Read Adventures Adventures Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Adventures",
        "tags": [
          "adventures"
        ]
      }
    },
    "/adventures/{adventure_id}": {
      "get": {
        "operationId": "read_adventure_adventures__adventure_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdventureDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Adventure",
        "tags": [
          "adventures"
        ]
      },
      "patch": {
        "operationId": "update_adventure_adventures__adventure_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdventureUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdventureDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "409": {
            "description": "Fight in progress: the active scene cannot change"
          },
          "422": {
            "description": "Scene does not belong to adventure, or validation error"
          }
        },
        "summary": "Update Adventure",
        "tags": [
          "adventures"
        ]
      }
    },
    "/adventures/{adventure_id}/scenes": {
      "get": {
        "operationId": "read_adventure_scenes_adventures__adventure_id__scenes_get",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SceneDetail"
                  },
                  "title": "Response Read Adventure Scenes Adventures  Adventure Id  Scenes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Adventure Scenes",
        "tags": [
          "adventures"
        ]
      }
    },
    "/scenes/{scene_id}": {
      "get": {
        "operationId": "read_scene_scenes__scene_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "scene_id",
            "required": true,
            "schema": {
              "title": "Scene Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SceneDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Scene not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Scene",
        "tags": [
          "scenes"
        ]
      }
    },
    "/table": {
      "get": {
        "operationId": "read_table_table_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameTableState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Table",
        "tags": [
          "table"
        ]
      },
      "patch": {
        "operationId": "update_table_table_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameTableUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameTableState"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Fight in progress: the active adventure cannot change"
          },
          "422": {
            "description": "Adventure not found, or validation error"
          }
        },
        "summary": "Update Table",
        "tags": [
          "table"
        ]
      }
    },
    "/table/audio": {
      "get": {
        "operationId": "read_audio_table_audio_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Audio",
        "tags": [
          "audio"
        ]
      },
      "patch": {
        "description": "Works without an audio output as well: the Admin that becomes the output starts with the stored state.",
        "operationId": "update_audio_table_audio_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AudioUpdate"
              }
            }
          },
          "required": true
