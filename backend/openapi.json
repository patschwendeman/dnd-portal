              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Scene Id"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "global_level": {
            "title": "Global Level",
