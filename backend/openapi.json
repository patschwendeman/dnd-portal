  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/adventures": {
      "get": {
        "description": "All adventures, ordered by ID, each with its level, players and adventure image (for the selection).",
        "operationId": "read_adventures_adventures_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdventureSummary"
                  },
                  "title": "Response Read Adventures Adventures Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Adventures",
        "tags": [
          "adventures"
        ]
      }
    },
    "/adventures/{adventure_id}": {
      "get": {
        "description": "The adventure with its players and background images; 404 for an unknown adventure.",
        "operationId": "read_adventure_adventures__adventure_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdventureDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Adventure",
        "tags": [
          "adventures"
        ]
      },
      "patch": {
        "description": "Changes the fields set in the body and pushes the state to all screens.\n\n404 for an unknown adventure; 422 if the active scene does not exist or belongs to another adventure; 409 if\nthe active scene would change while the adventure has a fight. On an error nothing is changed.",
        "operationId": "update_adventure_adventures__adventure_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdventureUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdventureDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "409": {
            "description": "Fight in progress: the active scene cannot change"
          },
          "422": {
            "description": "Scene does not belong to adventure, or validation error"
          }
        },
        "summary": "Update Adventure",
        "tags": [
          "adventures"
        ]
      }
    },
    "/adventures/{adventure_id}/scenes": {
      "get": {
        "description": "The scenes of the adventure, ordered by ID (an empty list without scenes); 404 for an unknown adventure.",
        "operationId": "read_adventure_scenes_adventures__adventure_id__scenes_get",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SceneDetail"
                  },
                  "title": "Response Read Adventure Scenes Adventures  Adventure Id  Scenes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Adventure Scenes",
        "tags": [
          "adventures"
        ]
      }
    },
    "/scenes/{scene_id}": {
      "get": {
        "description": "The scene with its images and tracks; 404 for an unknown scene.",
        "operationId": "read_scene_scenes__scene_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "scene_id",
            "required": true,
            "schema": {
              "title": "Scene Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SceneDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Scene not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Scene",
        "tags": [
          "scenes"
        ]
      }
    },
    "/table": {
      "get": {
        "description": "The state of the game table that the screens also receive as `state` over the WebSocket.",
        "operationId": "read_table_table_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameTableState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Table",
        "tags": [
          "table"
        ]
      },
      "patch": {
        "description": "Changes the fields set in the body and pushes the state to all screens.\n\nA change of the active adventure also pushes its fight and closes the Wall overlay, unless the request sets\none. 422 for an unknown adventure; 409 if the active adventure would change while it has a fight. On an\nerror nothing is changed.",
        "operationId": "update_table_table_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameTableUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameTableState"
                }
              }
            },
