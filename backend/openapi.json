            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Scene Id"
          },
          "global_level": {
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Global Level",
            "type": "integer"
          }
        },
        "title": "AdventureUpdate",
        "type": "object"
      },
