          "source"
        ],
        "title": "Image",
        "type": "object"
      },
      "JoinInfo": {
        "description": "How players join the game table: URL of the Player Screen in the LAN, `null` if unknown.",
        "properties": {
          "player_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Url"
          }
        },
        "required": [
          "player_url"
        ],
        "title": "JoinInfo",
        "type": "object"
      },
      "Player": {
        "description": "A person with their character in one adventure (another adventure has its own entry for the same person).",
        "properties": {
          "avatar": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Image"
              },
              {
                "type": "null"
              }
            ]
          },
          "character_class": {
            "title": "Character Class",
            "type": "string"
          },
          "character_name": {
            "title": "Character Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "player_name": {
            "title": "Player Name",
            "type": "string"
          },
          "race": {
            "title": "Race",
            "type": "string"
          }
        },
        "required": [
          "id",
          "player_name",
          "character_name",
          "race",
          "character_class",
          "avatar"
        ],
        "title": "Player",
        "type": "object"
      },
      "SceneDetail": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "ground_image": {
            "$ref": "#/components/schemas/Image"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/Track"
            },
            "title": "Tracks",
            "type": "array"
          },
          "wall_image": {
            "$ref": "#/components/schemas/Image"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "wall_image",
          "ground_image",
          "tracks"
        ],
        "title": "SceneDetail",
        "type": "object"
      },
      "SoundRequest": {
        "properties": {
          "name": {
            "enum": [
              "heal",
              "bottle",
              "buff",
              "music_1",
              "music_2",
              "spell_1",
              "spell_2",
              "debuff_1",
              "debuff_2",
              "lock"
            ],
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "SoundRequest",
        "type": "object"
      },
      "Track": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
