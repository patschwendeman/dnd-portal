    "/adventures": {
      "get": {
        "operationId": "read_adventures_adventures_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdventureSummary"
                  },
                  "title": "Response Read Adventures Adventures Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Adventures",
        "tags": [
          "adventures"
        ]
      }
    },
    "/adventures/{adventure_id}": {
      "get": {
        "operationId": "read_adventure_adventures__adventure_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdventureDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Adventure",
        "tags": [
          "adventures"
        ]
      },
      "patch": {
        "operationId": "update_adventure_adventures__adventure_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdventureUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdventureDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "422": {
            "description": "Scene does not belong to adventure, or validation error"
          }
        },
        "summary": "Update Adventure",
        "tags": [
          "adventures"
        ]
      }
    },
