{
  "components": {
    "schemas": {
      "AdventureDetail": {
        "properties": {
          "active_scene_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Scene Id"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "global_level": {
            "title": "Global Level",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/Player"
            },
            "title": "Players",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "global_level",
          "active_scene_id",
          "players"
        ],
        "title": "AdventureDetail",
        "type": "object"
      },
      "AdventureSummary": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "title": "AdventureSummary",
        "type": "object"
      },
      "AdventureUpdate": {
        "description": "Partial update: only the fields set in the request are changed (`active_scene_id: null` clears it).",
        "properties": {
          "active_scene_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Scene Id"
          },
          "global_level": {
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Global Level",
            "type": "integer"
          }
        },
        "title": "AdventureUpdate",
        "type": "object"
      },
      "AudioState": {
        "description": "Music of the game table, played by the Wall that is the audio output (`output_ready`); volume in percent.",
        "properties": {
          "output_ready": {
            "title": "Output Ready",
            "type": "boolean"
          },
          "playing": {
            "title": "Playing",
            "type": "boolean"
          },
          "track": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Track"
              },
              {
                "type": "null"
              }
            ]
          },
          "volume": {
            "title": "Volume",
            "type": "integer"
          }
        },
        "required": [
          "playing",
          "track",
          "volume",
          "output_ready"
        ],
        "title": "AudioState",
        "type": "object"
      },
      "AudioUpdate": {
        "description": "Partial update: only the fields set in the request are changed.",
        "properties": {
          "playing": {
            "title": "Playing",
            "type": "boolean"
          },
          "volume": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Volume",
            "type": "integer"
          }
        },
        "title": "AudioUpdate",
        "type": "object"
      },
      "GameTableState": {
        "description": "State of the game table shared by Admin, Wall and Ground; `active_scene_id` belongs to the active adventure.",
        "properties": {
          "active_adventure_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Adventure Id"
          },
          "active_scene_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Scene Id"
          },
          "theme": {
            "enum": [
              "dark",
              "tavern"
            ],
            "title": "Theme",
            "type": "string"
          }
        },
        "required": [
          "active_adventure_id",
          "active_scene_id",
          "theme"
        ],
        "title": "GameTableState",
        "type": "object"
      },
      "GameTableUpdate": {
        "description": "Partial update: only the fields set in the request are changed (`active_adventure_id: null` clears it).",
        "properties": {
          "active_adventure_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Adventure Id"
          },
          "theme": {
            "enum": [
              "dark",
              "tavern"
            ],
            "title": "Theme",
            "type": "string"
          }
        },
        "title": "GameTableUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Image": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "source"
        ],
        "title": "Image",
        "type": "object"
      },
      "JoinInfo": {
        "description": "How players join the game table: URL of the Player Screen in the LAN, `null` if unknown.",
        "properties": {
          "player_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Url"
          }
        },
        "required": [
          "player_url"
        ],
        "title": "JoinInfo",
        "type": "object"
      },
      "MapEntry": {
        "description": "A tile in the map overviews: `id` is the scene ID, `source` its ground (Kampfszene) or wall image.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source"
        ],
        "title": "MapEntry",
        "type": "object"
      },
      "Player": {
        "description": "A person with their character in one adventure (another adventure has its own entry for the same person).",
        "properties": {
          "avatar": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Image"
              },
              {
                "type": "null"
              }
            ]
          },
          "character_class": {
            "title": "Character Class",
            "type": "string"
          },
          "character_name": {
            "title": "Character Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "player_name": {
            "title": "Player Name",
            "type": "string"
          },
          "race": {
            "title": "Race",
            "type": "string"
          }
        },
        "required": [
          "id",
          "player_name",
          "character_name",
          "race",
          "character_class",
          "avatar"
        ],
        "title": "Player",
        "type": "object"
      },
      "SceneDetail": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "ground_image": {
            "$ref": "#/components/schemas/Image"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "main": {
            "title": "Main",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/Track"
            },
            "title": "Tracks",
            "type": "array"
          },
          "wall_image": {
            "$ref": "#/components/schemas/Image"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "main",
          "wall_image",
          "ground_image",
          "tracks"
        ],
        "title": "SceneDetail",
        "type": "object"
      },
      "SoundRequest": {
        "properties": {
          "name": {
            "enum": [
              "heal",
              "bottle",
              "buff",
              "music_1",
              "music_2",
              "spell_1",
              "spell_2",
              "debuff_1",
              "debuff_2",
              "lock"
            ],
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "SoundRequest",
        "type": "object"
      },
      "Track": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "source"
        ],
        "title": "Track",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/adventures": {
      "get": {
        "operationId": "read_adventures_adventures_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdventureSummary"
                  },
                  "title": "Response Read Adventures Adventures Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Adventures",
        "tags": [
          "adventures"
        ]
      }
    },
    "/adventures/{adventure_id}": {
      "get": {
        "operationId": "read_adventure_adventures__adventure_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdventureDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Adventure",
        "tags": [
          "adventures"
        ]
      },
      "patch": {
        "operationId": "update_adventure_adventures__adventure_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdventureUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdventureDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "422": {
            "description": "Scene does not belong to adventure, or validation error"
          }
        },
        "summary": "Update Adventure",
        "tags": [
          "adventures"
        ]
      }
    },
    "/adventures/{adventure_id}/maps/main": {
      "get": {
        "operationId": "read_adventure_mainmaps_adventures__adventure_id__maps_main_get",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MapEntry"
                  },
                  "title": "Response Read Adventure Mainmaps Adventures  Adventure Id  Maps Main Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Adventure Mainmaps",
        "tags": [
          "adventures"
        ]
      }
    },
    "/adventures/{adventure_id}/maps/side": {
      "get": {
        "operationId": "read_adventure_sidemaps_adventures__adventure_id__maps_side_get",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MapEntry"
                  },
                  "title": "Response Read Adventure Sidemaps Adventures  Adventure Id  Maps Side Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Adventure Sidemaps",
        "tags": [
          "adventures"
        ]
      }
    },
    "/adventures/{adventure_id}/scenes": {
      "get": {
        "operationId": "read_adventure_scenes_adventures__adventure_id__scenes_get",
        "parameters": [
          {
            "in": "path",
            "name": "adventure_id",
            "required": true,
            "schema": {
              "title": "Adventure Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SceneDetail"
                  },
                  "title": "Response Read Adventure Scenes Adventures  Adventure Id  Scenes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Adventure not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Adventure Scenes",
        "tags": [
          "adventures"
        ]
      }
    },
    "/scenes/{scene_id}": {
      "get": {
        "operationId": "read_scene_scenes__scene_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "scene_id",
            "required": true,
            "schema": {
              "title": "Scene Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SceneDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Scene not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Scene",
        "tags": [
          "scenes"
        ]
      }
    },
    "/table": {
      "get": {
        "operationId": "read_table_table_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameTableState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Table",
        "tags": [
          "table"
        ]
      },
      "patch": {
        "operationId": "update_table_table_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameTableUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameTableState"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Adventure not found, or validation error"
          }
        },
        "summary": "Update Table",
        "tags": [
          "table"
        ]
      }
    },
    "/table/audio": {
      "get": {
        "operationId": "read_audio_table_audio_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Audio",
        "tags": [
          "audio"
        ]
      },
      "patch": {
        "description": "Works without an audio output as well: the Wall that becomes the output starts with the stored state.",
        "operationId": "update_audio_table_audio_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AudioUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioState"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Volume out of range, or validation error"
          }
        },
        "summary": "Update Audio",
        "tags": [
          "audio"
        ]
      }
    },
    "/table/join": {
      "get": {
        "operationId": "read_join_info_table_join_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Join Info",
        "tags": [
          "table"
        ]
      }
    },
    "/table/sounds": {
      "post": {
        "description": "Plays the sound effect on the audio output; without an output it is dropped (204 anyway).",
        "operationId": "play_sound_table_sounds_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SoundRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Unknown sound, or validation error"
          }
        },
        "summary": "Play Sound",
        "tags": [
          "audio"
        ]
      }
    }
  }
}
